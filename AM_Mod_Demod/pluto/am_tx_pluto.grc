options:
  parameters:
    title: AM TX - message and envelope
    author: Aya
    copyright: ''
    description: 'AM TX v2: native GNU Radio blocks, ka control, explicit carrier
      and signed envelope.'
    output_language: python
    generate_options: qt_gui
    gen_linking: dynamic
    gen_cmake: 'On'
    cmake_opt: ''
    category: '[GRC Hier Blocks]'
    run_options: prompt
    placement: (0,0)
    window_size: (1200,800)
    sizing_mode: fixed
    run: 'True'
    max_nouts: '0'
    realtime_scheduling: ''
    qt_qss_theme: ''
    thread_safe_setters: ''
    catch_exceptions: 'True'
    run_command: '{python} -u {filename}'
    hier_block_src_path: '.:'
    id: am_tx_pluto_v2
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: '2400000'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 96
    rotation: 0
    state: enabled
- name: lo_freq
  id: variable
  parameters:
    value: '2450000000'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 192
    - 96
    rotation: 0
    state: enabled
- name: carrier_offset
  id: variable
  parameters:
    value: '200000'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 384
    - 96
    rotation: 0
    state: enabled
- name: carrier_amp
  id: variable
  parameters:
    value: '0.35'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 576
    - 96
    rotation: 0
    state: enabled
- name: msg_amp
  id: variable
  parameters:
    value: '1.0'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 768
    - 96
    rotation: 0
    state: enabled
- name: pluto_uri
  id: variable
  parameters:
    value: ''''''
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 944
    - 96
    rotation: 0
    state: enabled
- name: channel_rate
  id: variable
  parameters:
    value: samp_rate // 50
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1136
    - 96
    rotation: 0
    state: enabled
- name: mu
  id: variable
  parameters:
    value: ka * msg_amp
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1328
    - 96
    rotation: 0
    state: enabled
- name: ka
  id: variable_qtgui_range
  parameters:
    label: 'ka (Am=1: modulation index = ka)'
    rangeType: float
    value: '0.5'
    start: '0'
    stop: '1.4'
    step: '0.05'
    widget: counter_slider
    orient: QtCore.Qt.Horizontal
    min_len: '220'
    gui_hint: 0,0,1,1
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 200
    rotation: 0
    state: enabled
- name: message_freq
  id: variable_qtgui_range
  parameters:
    label: Message frequency (Hz)
    rangeType: float
    value: '1000'
    start: '200'
    stop: '3000'
    step: '100'
    widget: counter_slider
    orient: QtCore.Qt.Horizontal
    min_len: '220'
    gui_hint: 0,1,1,1
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 304
    - 200
    rotation: 0
    state: enabled
- name: tx_atten
  id: variable_qtgui_range
  parameters:
    label: TX attenuation (dB; larger = weaker)
    rangeType: float
    value: '40'
    start: '10'
    stop: '70'
    step: '1'
    widget: counter_slider
    orient: QtCore.Qt.Horizontal
    min_len: '220'
    gui_hint: 0,2,1,1
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 592
    - 200
    rotation: 0
    state: enabled
- name: tabs
  id: qtgui_tab_widget
  parameters:
    num_tabs: '3'
    label0: 1 AM + envelope
    label1: 2 Message + carrier
    label2: 3 TX spectrum
    label3: Tab 3
    label4: Tab 4
    label5: Tab 5
    label6: Tab 6
    label7: Tab 7
    label8: Tab 8
    label9: Tab 9
    label10: Tab 10
    label11: Tab 11
    label12: Tab 12
    label13: Tab 13
    label14: Tab 14
    label15: Tab 15
    label16: Tab 16
    label17: Tab 17
    label18: Tab 18
    label19: Tab 19
    gui_hint: 1,0,1,3
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 928
    - 192
    rotation: 0
    state: enabled
- name: message
  id: analog_sig_source_x
  parameters:
    type: float
    samp_rate: samp_rate
    waveform: analog.GR_COS_WAVE
    freq: message_freq
    amp: msg_amp
    offset: '0'
    phase: '0'
    showports: 'False'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 384
    rotation: 0
    state: enabled
- name: scale_ka
  id: blocks_multiply_const_vxx
  parameters:
    type: float
    const: ka
    vlen: '1'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 256
    - 400
    rotation: 0
    state: enabled
- name: add_one
  id: blocks_add_const_vxx
  parameters:
    type: float
    const: '1.0'
    vlen: '1'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 464
    - 400
    rotation: 0
    state: enabled
- name: scale_carrier
  id: blocks_multiply_const_vxx
  parameters:
    type: float
    const: carrier_amp
    vlen: '1'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 656
    - 400
    rotation: 0
    state: enabled
- name: real_envelope_to_complex
  id: blocks_float_to_complex
  parameters:
    vlen: '1'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 880
    - 400
    rotation: 0
    state: enabled
- name: am_modulator
  id: blocks_multiply_xx
  parameters:
    type: complex
    num_inputs: '2'
    vlen: '1'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1088
    - 400
    rotation: 0
    state: enabled
- name: carrier
  id: analog_sig_source_x
  parameters:
    type: complex
    samp_rate: samp_rate
    waveform: analog.GR_COS_WAVE
    freq: carrier_offset
    amp: '1.0'
    offset: '0'
    phase: '0'
    showports: 'False'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 848
    - 576
    rotation: 0
    state: enabled
- name: pluto_tx
  id: iio_pluto_sink
  parameters:
    type: fc32
    uri: pluto_uri
    frequency: int(lo_freq)
    samplerate: int(samp_rate)
    buffer_size: '32768'
    cyclic: 'False'
    attenuation1: tx_atten
    len_tag_key: ''
    filter_source: '''Auto'''
    filter: ''
    fpass: '0'
    fstop: '0'
    bandwidth: '2000000'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1296
    - 352
    rotation: 0
    state: enabled
- name: am_real
  id: blocks_complex_to_real
  parameters:
    vlen: '1'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1120
    - 704
    rotation: 0
    state: enabled
- name: lower_envelope
  id: blocks_multiply_const_vxx
  parameters:
    type: float
    const: '-1.0'
    vlen: '1'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 640
    - 704
    rotation: 0
    state: enabled
