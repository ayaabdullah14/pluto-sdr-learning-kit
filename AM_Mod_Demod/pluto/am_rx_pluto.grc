    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1120
    - 704
    rotation: 0
    state: enabled
- name: recovered_spectrum
  id: qtgui_freq_sink_x
  parameters:
    type: float
    name: Message spectrum (positive frequencies)
    fftsize: '4096'
    freqhalf: 'False'
    wintype: window.WIN_BLACKMAN_hARRIS
