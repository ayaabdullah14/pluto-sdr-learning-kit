options:
  parameters:
    title: AM audio - RX
    author: Aya - SDR learning course
    copyright: ''
    description: ''
    output_language: python
    generate_options: qt_gui
    gen_linking: dynamic
    gen_cmake: 'On'
    cmake_opt: ''
    category: '[GRC Hier Blocks]'
    run_options: prompt
    placement: (0,0)
    window_size: (1100,800)
    sizing_mode: fixed
    run: 'True'
    max_nouts: '0'
    realtime_scheduling: ''
    qt_qss_theme: ''
    thread_safe_setters: ''
    catch_exceptions: 'True'
    run_command: '{python} -u {filename}'
    hier_block_src_path: '.:'
    id: ex05_rx_audio
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: '2400000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 16
    rotation: 0
    state: enabled
- name: rf_center
  id: variable
  parameters:
    value: '2450000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 470
    - 16
    rotation: 0
    state: enabled
- name: rf_bw
  id: variable
  parameters:
    value: '20000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 700
    - 16
    rotation: 0
    state: enabled
- name: device_uri
  id: variable
  parameters:
    value: '''ip:192.168.2.1'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 930
    - 16
    rotation: 0
    state: enabled
- name: rx_gain_db
  id: variable
  parameters:
    value: '20'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1160
    - 16
    rotation: 0
    state: enabled
- name: channel_offset
  id: variable
  parameters:
    value: '100000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 98
    rotation: 0
    state: enabled
- name: channel_rate
  id: variable
  parameters:
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 470
    - 98
    rotation: 0
    state: enabled
- name: radio_rx
  id: iio_pluto_source
  parameters:
    type: fc32
    uri: device_uri
    frequency: rf_center
    samplerate: samp_rate
    buffer_size: '32768'
    quadrature: 'True'
    rfdc: 'True'
    bbdc: 'True'
    gain1: '''manual'''
    manual_gain1: rx_gain_db
    len_tag_key: ''
    filter_source: '''Off'''
    filter: ''
    fpass: '0'
    fstop: '0'
    bandwidth: rf_bw
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 80
    - 360
    rotation: 0
    state: enabled
- name: select_beacon
  id: freq_xlating_fir_filter_xxx
  parameters:
    type: ccf
    decim: '50'
    taps: firdes.low_pass(1.0, samp_rate, 5000, 3000, window.WIN_HAMMING, 6.76)
    center_freq: channel_offset
    samp_rate: samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 380
    - 360
    rotation: 0
    state: enabled
- name: envelope_detector
  id: blocks_complex_to_mag
  parameters:
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 700
    - 360
    rotation: 0
    state: enabled
- name: remove_carrier_dc
  id: dc_blocker_xx
  parameters:
    type: ff
    length: '1024'
    long_form: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 970
    - 360
    rotation: 0
    state: enabled
- name: audio_gain
  id: variable
  parameters:
    value: '10.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 700
    - 98
    rotation: 0
    state: enabled
- name: listening_gain
  id: blocks_multiply_const_vxx
  parameters:
    type: float
    const: audio_gain
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1230
    - 360
    rotation: 0
    state: enabled
- name: speakers
  id: audio_sink
  parameters:
    samp_rate: '48000'
    device_name: ''
    ok_to_block: 'True'
    num_inputs: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1510
    - 360
    rotation: 0
    state: enabled
- name: selected_spectrum
  id: qtgui_freq_sink_x
  parameters:
    type: complex
    name: Selected AM channel - carrier should be near 0 Hz
    fftsize: '4096'
    freqhalf: 'False'
    wintype: window.WIN_HANN
    norm_window: 'False'
    fc: '0'
    bw: channel_rate
    grid: 'True'
    autoscale: 'False'
    average: 'False'
    ymin: '-120'
    ymax: '10'
    label: Digital spectral level
    units: dB
    nconnections: '1'
    update_time: '0.15'
    showports: 'False'
    gui_hint: 1,0,1,1
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_level: '0.0'
    tr_chan: '0'
    tr_tag: '""'
    ctrlpanel: 'False'
    legend: 'True'
    axislabels: 'True'
    label1: Input
    width1: '1'
    color1: red
    alpha1: '1.0'
    label2: Filtered
    width2: '1'
    color2: blue
    alpha2: '1.0'
    label3: ''''''
    width3: '1'
    color3: '"green"'
    alpha3: '1.0'
    label4: ''''''
    width4: '1'
    color4: '"black"'
    alpha4: '1.0'
    label5: ''''''
    width5: '1'
    color5: '"cyan"'
    alpha5: '1.0'
    label6: ''''''
    width6: '1'
    color6: '"magenta"'
    alpha6: '1.0'
    label7: ''''''
    width7: '1'
    color7: '"yellow"'
    alpha7: '1.0'
    label8: ''''''
    width8: '1'
    color8: '"dark red"'
    alpha8: '1.0'
    label9: ''''''
    width9: '1'
    color9: '"dark green"'
    alpha9: '1.0'
    label10: ''''''
    width10: '1'
    color10: '"dark blue"'
    alpha10: '1.0'
    averaging: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 700
    - 700
    rotation: 0
    state: enabled
- name: recovered_message
  id: qtgui_time_sink_x
  parameters:
    type: float
    name: Recovered audio
    ylabel: Digital amplitude
    yunit: ''
    size: '384'
    srate: channel_rate
    grid: 'True'
    autoscale: 'True'
    ymin: '-0.1'
    ymax: '0.1'
    nconnections: '1'
    update_time: '0.1'
    entags: 'False'
    gui_hint: 0,0,1,1
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_MODE_POS
    tr_level: '0.0'
    tr_delay: '0'
    tr_chan: '0'
    tr_tag: '""'
    ctrlpanel: 'False'
    legend: 'True'
    axislabels: 'True'
    stemplot: 'False'
    label1: Signal
    width1: '2'
    color1: red
    style1: '1'
    marker1: '-1'
    alpha1: '1.0'
    label2: Envelope
    width2: '2'
    color2: blue
    style2: '1'
    marker2: '-1'
    alpha2: '1.0'
    label3: Lower envelope
    width3: '2'
    color3: blue
    style3: '1'
    marker3: '-1'
    alpha3: '1.0'
    label4: Signal 4
    width4: '1'
    color4: black
    style4: '1'
    marker4: '-1'
    alpha4: '1.0'
    label5: Signal 5
    width5: '1'
    color5: cyan
    style5: '1'
    marker5: '-1'
    alpha5: '1.0'
    label6: Signal 6
    width6: '1'
    color6: magenta
    style6: '1'
    marker6: '-1'
    alpha6: '1.0'
    label7: Signal 7
    width7: '1'
    color7: yellow
    style7: '1'
    marker7: '-1'
    alpha7: '1.0'
    label8: Signal 8
    width8: '1'
    color8: dark red
    style8: '1'
    marker8: '-1'
    alpha8: '1.0'
    label9: Signal 9
    width9: '1'
    color9: dark green
    style9: '1'
    marker9: '-1'
    alpha9: '1.0'
    label10: Signal 10
    width10: '1'
    color10: dark blue
    style10: '1'
    marker10: '-1'
    alpha10: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1510
    - 660
    rotation: 0
    state: enabled
connections:
- - radio_rx
  - '0'
  - select_beacon
  - '0'
- - select_beacon
  - '0'
  - envelope_detector
  - '0'
- - envelope_detector
  - '0'
  - remove_carrier_dc
  - '0'
- - remove_carrier_dc
  - '0'
  - listening_gain
  - '0'
- - listening_gain
  - '0'
  - speakers
  - '0'
- - select_beacon
  - '0'
  - selected_spectrum
  - '0'
- - listening_gain
  - '0'
  - recovered_message
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.12.0
