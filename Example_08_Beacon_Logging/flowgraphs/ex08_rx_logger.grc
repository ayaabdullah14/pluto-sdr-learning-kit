- name: power_display
  id: qtgui_number_sink
  parameters:
    name: Selected channel power - relative digital dB
    type: float
    autoscale: 'False'
    avg: '0'
    graph_type: qtgui.NUM_GRAPH_NONE
    nconnections: '1'
    min: '-120'
    max: '0'
    update_time: '0.10'
    gui_hint: 1,0,1,1
    label1: 10 log10(mean |z|^2)
    unit1: dB re 1 digital unit squared
    color1: ("black", "black")
    factor1: '1'
    label2: ''
    unit2: ''
    color2: ("black", "black")
