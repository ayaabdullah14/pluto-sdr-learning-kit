    label3: ''
    unit3: ''
    color3: ("black", "black")
    factor3: '1'
    label4: ''
    unit4: ''
    color4: ("black", "black")
    factor4: '1'
    label5: ''
    unit5: ''
    color5: ("black", "black")
    factor5: '1'
    label6: ''
    unit6: ''
    color6: ("black", "black")
    factor6: '1'
    label7: ''
    unit7: ''
    color7: ("black", "black")
    factor7: '1'
    label8: ''
    unit8: ''
    color8: ("black", "black")
    factor8: '1'
    label9: ''
    unit9: ''
    color9: ("black", "black")
    factor9: '1'
    label10: ''
    unit10: ''
    color10: ("black", "black")
    factor10: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1680
    - 1000
    rotation: 0
