    bus_source: false
    bus_structure: null
    coordinate:
    - 1200
    - 1000
    rotation: 0
    state: enabled
- name: relative_power_db
  id: blocks_nlog10_ff
  parameters:
    n: '10'
    k: '0'
    vlen: '1'
  states:
