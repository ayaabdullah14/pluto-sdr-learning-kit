- name: run_label
  id: variable
  parameters:
    value: '''tx_off'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 700
    - 98
    rotation: 0
    state: enabled
- name: log_file
  id: variable
  parameters:
    value: '''beacon_log.csv'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 930
    - 98
    rotation: 0
    state: enabled
- name: measurement_logger
  id: epy_block
  parameters:
    _source_code: "\"\"\"GNU Radio embedded measurement sink. No files are opened\
      \ during GRC inspection.\"\"\"\nimport csv\nfrom datetime import datetime, timezone\n\
      from pathlib import Path\nimport time\nimport uuid\nimport numpy as np\nfrom\
      \ gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    \"\"\"Log nonoverlapping\
      \ channel-power windows with host processing timestamps.\n\n    The timestamps\
      \ are NOT sample-synchronized radio timestamps. A run_label is\n    manually\
      \ assigned metadata; it is not an identity decoded from the beacon.\n    Stop\
      \ the graph before changing settings. Initial one second is discarded.\n   \
      \ \"\"\"\n    def __init__(self, sample_rate=48000, window_samples=4800,\n \
      \                output_file='beacon_log.csv', run_label='tx_off',\n       \
      \          rf_center_hz=2450000000, channel_offset_hz=100000,\n            \
      \     rx_gain_db=20):\n        gr.sync_block.__init__(self, name='Timestamped\
      \ channel-power logger',\n                               in_sig=[np.complex64],\
      \ out_sig=[])\n        self._fs = int(sample_rate)\n        self._window = int(window_samples)\n\
      \        if self._fs <= 0 or self._window <= 0:\n            raise ValueError('Sample\
      \ rate and window size must be positive')\n        self._filename = str(output_file)\n\
      \        self._label = str(run_label)\n        self._rf = float(rf_center_hz)\n\
      \        self._offset = float(channel_offset_hz)\n        self._gain = float(rx_gain_db)\n\
      \        self._skip = self._fs\n        self._next_start = self._fs\n      \
      \  self._pending = np.empty(0, dtype=np.complex64)\n        self._handle = None\n\
      \        self._writer = None\n        self._seq = 0\n\n    def _open(self):\n\
      \        target = Path(self._filename).expanduser().resolve()\n        target.parent.mkdir(parents=True,\
      \ exist_ok=True)\n        while True:\n            try:\n                self._handle\
      \ = target.open('x', newline='', encoding='utf-8')\n                break\n\
      \            except FileExistsError:\n                stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S')\n\
      \                target = target.with_name(target.stem + '_' + stamp + '_' +\
      \ uuid.uuid4().hex[:6] + target.suffix)\n        fields = ['host_processed_utc','host_monotonic_s','sequence','run_label',\n\
      \                  'sample_start','sample_end_exclusive','stream_start_s','window_s',\n\
      \                  'sample_rate_sps','rf_center_hz','channel_offset_hz','rx_gain_db',\n\
      \                  'gain_mode','channel_cutoff_hz','transition_width_hz',\n\
      \                  'power_linear_digital','power_db_re_1','valid']\n       \
      \ self._writer = csv.DictWriter(self._handle, fieldnames=fields)\n        self._writer.writeheader()\n\
      \        print('Power log:', target, flush=True)\n\n    def work(self, input_items,\
      \ output_items):\n        original = input_items[0]\n        data = original\n\
      \        if self._skip:\n            count = min(self._skip, len(data))\n  \
      \          data = data[count:]\n            self._skip -= count\n        if\
      \ len(data):\n            if self._handle is None:\n                self._open()\n\
      \            self._pending = np.concatenate((self._pending, data))\n       \
      \     n_complete = len(self._pending) // self._window\n            for i in\
      \ range(n_complete):\n                z = self._pending[i*self._window:(i+1)*self._window].astype(np.complex128)\n\
      \                valid = bool(np.all(np.isfinite(z)))\n                p = float(np.mean(np.abs(z)**2))\
      \ if valid else float('nan')\n                db = float(10*np.log10(p)) if\
      \ valid and p > 0 else None\n                self._writer.writerow(dict(\n \
      \                   host_processed_utc=datetime.now(timezone.utc).isoformat(timespec='milliseconds'),\n\
      \                    host_monotonic_s=f'{time.monotonic():.6f}', sequence=self._seq,\n\
      \                    run_label=self._label, sample_start=self._next_start,\n\
      \                    sample_end_exclusive=self._next_start+self._window,\n \
      \                   stream_start_s=self._next_start/self._fs, window_s=self._window/self._fs,\n\
      \                    sample_rate_sps=self._fs, rf_center_hz=self._rf,\n    \
      \                channel_offset_hz=self._offset, rx_gain_db=self._gain,\n  \
      \                  gain_mode='manual',channel_cutoff_hz=5000, transition_width_hz=3000,\n\
      \                    power_linear_digital=p if valid else '',\n            \
      \        power_db_re_1=db if db is not None else '',valid=int(valid)))\n   \
      \             self._seq += 1\n                self._next_start += self._window\n\
      \            self._pending = self._pending[n_complete*self._window:].copy()\n\
      \            self._handle.flush()\n        return len(original)\n\n    def stop(self):\n\
      \        if self._handle is not None:\n            self._handle.flush()\n  \
      \          self._handle.close()\n            self._handle = None\n        return\
      \ True\n"
    sample_rate: channel_rate
    window_samples: '4800'
    output_file: log_file
    run_label: run_label
    rf_center_hz: rf_center
    channel_offset_hz: channel_offset
    rx_gain_db: rx_gain_db
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 740
    - 650
    rotation: 0
    state: enabled
connections:
- - radio_rx
  - '0'
  - select_beacon
  - '0'
- - select_beacon
  - '0'
  - selected_spectrum
  - '0'
- - select_beacon
  - '0'
  - instant_power
  - '0'
- - instant_power
  - '0'
  - average_power
  - '0'
- - average_power
  - '0'
  - report_10_per_second
  - '0'
- - report_10_per_second
  - '0'
  - relative_power_db
  - '0'
- - relative_power_db
  - '0'
  - power_display
  - '0'
- - select_beacon
  - '0'
  - measurement_logger
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.12.0
