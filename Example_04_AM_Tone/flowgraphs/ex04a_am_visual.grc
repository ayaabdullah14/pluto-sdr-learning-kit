options:
  parameters:
    title: Example 4A - See AM and its envelope
    author: Aya - SDR learning course
    copyright: ''
    description: ''
    output_language: python
    generate_options: qt_gui
    gen_linking: dynamic
    gen_cmake: 'On'
    cmake_opt: ''
    category: '[GRC Hier Blocks]'
    run_options: prompt
    placement: (0,0)
    window_size: (1100,800)
    sizing_mode: fixed
    run: 'True'
    max_nouts: '0'
    realtime_scheduling: ''
    qt_qss_theme: ''
    thread_safe_setters: ''
    catch_exceptions: 'True'
    run_command: '{python} -u {filename}'
    hier_block_src_path: '.:'
    id: ex04a_am_visual
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: '192000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 16
    rotation: 0
    state: enabled
- name: message_hz
  id: variable
  parameters:
    value: '500'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 470
    - 16
    rotation: 0
    state: enabled
- name: visual_carrier_hz
  id: variable
  parameters:
    value: '10000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 700
    - 16
    rotation: 0
    state: enabled
- name: carrier_amplitude
  id: variable
  parameters:
    value: '0.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 930
    - 16
    rotation: 0
    state: enabled
- name: modulation_index
  id: variable
  parameters:
    value: '0.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1160
    - 16
    rotation: 0
    state: enabled
- name: spectrum_rate
  id: variable
  parameters:
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 98
    rotation: 0
    state: enabled
- name: positive_envelope
  id: analog_sig_source_x
  parameters:
    type: float
    samp_rate: samp_rate
    waveform: analog.GR_COS_WAVE
    freq: message_hz
    amp: carrier_amplitude*modulation_index
    offset: carrier_amplitude
    phase: '0'
    showports: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 80
    - 300
    rotation: 0
    state: enabled
- name: simulation_clock
  id: blocks_throttle2
  parameters:
    type: float
    samples_per_second: samp_rate
    vlen: '1'
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 360
    - 300
    rotation: 0
    state: enabled
- name: visual_carrier
  id: analog_sig_source_x
  parameters:
    type: float
    samp_rate: samp_rate
    waveform: analog.GR_COS_WAVE
    freq: visual_carrier_hz
    amp: '1'
    offset: '0'
    phase: '0'
    showports: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 360
    - 560
    rotation: 0
    state: enabled
- name: am_product
  id: blocks_multiply_xx
  parameters:
    type: float
    num_inputs: '2'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 670
    - 360
    rotation: 0
    state: enabled
- name: am_and_envelope
  id: qtgui_time_sink_x
  parameters:
    type: float
    name: 'AM: red waveform, blue positive envelope'
    ylabel: Digital amplitude
    yunit: ''
    size: '768'
    srate: samp_rate
    grid: 'True'
    autoscale: 'False'
    ymin: '-0.85'
    ymax: '0.85'
    nconnections: '2'
    update_time: '0.1'
    entags: 'False'
    gui_hint: 0,0,1,1
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_MODE_POS
    tr_level: '0.0'
    tr_delay: '0'
    tr_chan: '0'
    tr_tag: '""'
    ctrlpanel: 'False'
    legend: 'True'
    axislabels: 'True'
    stemplot: 'False'
    label1: AM waveform
    width1: '2'
    color1: red
    style1: '1'
    marker1: '-1'
    alpha1: '1.0'
    label2: Envelope
    width2: '2'
    color2: blue
    style2: '1'
    marker2: '-1'
    alpha2: '1.0'
    label3: Lower envelope
    width3: '2'
    color3: blue
    style3: '1'
    marker3: '-1'
    alpha3: '1.0'
    label4: Signal 4
    width4: '1'
    color4: black
    style4: '1'
    marker4: '-1'
    alpha4: '1.0'
    label5: Signal 5
    width5: '1'
    color5: cyan
    style5: '1'
    marker5: '-1'
    alpha5: '1.0'
    label6: Signal 6
    width6: '1'
    color6: magenta
    style6: '1'
    marker6: '-1'
    alpha6: '1.0'
    label7: Signal 7
    width7: '1'
    color7: yellow
    style7: '1'
    marker7: '-1'
    alpha7: '1.0'
    label8: Signal 8
    width8: '1'
    color8: dark red
    style8: '1'
    marker8: '-1'
    alpha8: '1.0'
    label9: Signal 9
    width9: '1'
    color9: dark green
    style9: '1'
    marker9: '-1'
    alpha9: '1.0'
    label10: Signal 10
    width10: '1'
    color10: dark blue
    style10: '1'
    marker10: '-1'
    alpha10: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 990
    - 290
    rotation: 0
    state: enabled
- name: spectrum_rate_conversion
  id: low_pass_filter
  parameters:
    type: fir_filter_fff
    decim: '4'
    interp: '1'
    gain: '1'
    samp_rate: samp_rate
    cutoff_freq: '14000'
    width: '4000'
    win: window.WIN_HAMMING
    beta: '6.76'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 990
    - 620
    rotation: 0
    state: enabled
- name: am_spectrum
  id: qtgui_freq_sink_x
  parameters:
    type: float
    name: AM spectrum - carrier 10 kHz, sidebands 9.5 and 10.5 kHz
    fftsize: '4096'
    freqhalf: 'False'
    wintype: window.WIN_HANN
    norm_window: 'False'
    fc: '0'
    bw: spectrum_rate
    grid: 'True'
    autoscale: 'False'
    average: 'False'
    ymin: '-120'
    ymax: '10'
    label: Digital spectral level
    units: dB
    nconnections: '1'
    update_time: '0.15'
    showports: 'False'
    gui_hint: 1,0,1,1
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_level: '0.0'
    tr_chan: '0'
    tr_tag: '""'
    ctrlpanel: 'False'
    legend: 'True'
    axislabels: 'True'
    label1: Input
    width1: '1'
    color1: red
    alpha1: '1.0'
    label2: Filtered
    width2: '1'
    color2: blue
    alpha2: '1.0'
    label3: ''''''
    width3: '1'
    color3: '"green"'
    alpha3: '1.0'
    label4: ''''''
    width4: '1'
    color4: '"black"'
    alpha4: '1.0'
    label5: ''''''
    width5: '1'
    color5: '"cyan"'
    alpha5: '1.0'
    label6: ''''''
    width6: '1'
    color6: '"magenta"'
    alpha6: '1.0'
    label7: ''''''
    width7: '1'
    color7: '"yellow"'
    alpha7: '1.0'
    label8: ''''''
    width8: '1'
    color8: '"dark red"'
    alpha8: '1.0'
    label9: ''''''
    width9: '1'
    color9: '"dark green"'
    alpha9: '1.0'
    label10: ''''''
    width10: '1'
    color10: '"dark blue"'
    alpha10: '1.0'
    averaging: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1300
    - 620
    rotation: 0
    state: enabled
connections:
- - positive_envelope
  - '0'
  - simulation_clock
  - '0'
- - simulation_clock
  - '0'
  - am_product
  - '0'
- - visual_carrier
  - '0'
  - am_product
  - '1'
- - am_product
  - '0'
  - am_and_envelope
  - '0'
- - simulation_clock
  - '0'
  - am_and_envelope
  - '1'
- - am_product
  - '0'
  - spectrum_rate_conversion
  - '0'
- - spectrum_rate_conversion
  - '0'
  - am_spectrum
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.12.0
