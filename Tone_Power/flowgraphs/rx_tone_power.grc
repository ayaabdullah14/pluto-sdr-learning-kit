options:
  parameters: {author: '', catch_exceptions: 'True', category: '[GRC Hier Blocks]',
    comment: '', copyright: '', description: PlutoSDR Source -> Frequency Sink (find
      the tone) and Xlating filter -> |x|^2 -> Moving Average -> 10*log10 -> Number
      Sink, generate_options: qt_gui, hier_block_src_path: '.:', id: rx_tone_power,
    max_nouts: '0', output_language: python, placement: '(0,0)', qt_qss_theme: '',
    realtime_scheduling: '', run: 'True', run_command: '{python} -u {filename}', run_options: prompt,
    sizing_mode: fixed, thread_safe_setters: '', title: 'Tone receiver: spectrum and
      averaged channel power (Laptop 2)', window_size: '(1100,800)'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled
blocks:
- name: pluto_uri
  id: variable
  parameters: {value: '"ip:192.168.2.1"', comment: 'ENTER YOUR URI HERE. Find it with:
      iio_info -s  (copy the text inside [ ], e.g. ip:192.168.2.1 or usb:1.5.5). Each
      laptop has its OWN Pluto.'}
  states:
    coordinate: [8, 100]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters: {value: '960000', comment: Pluto sample rate (S/s). Replace with your
      known-working value if different.}
  states:
    coordinate: [8, 170]
    rotation: 0
    state: enabled
- name: lo_freq
  id: variable
  parameters: {value: '2450000000', comment: Radio centre frequency (Hz). Must be
      IDENTICAL on TX and RX. Use a frequency you are permitted to use.}
  states:
    coordinate: [8, 240]
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable
  parameters: {value: '30', comment: FIXED manual RX gain (dB). Do NOT change between
      comparisons. Not a slider on purpose.}
  states:
    coordinate: [8, 380]
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters: {value: '20', comment: 'Decimation of the measurement channel: 960000/20
      = 48000 S/s.'}
  states:
    coordinate: [8, 450]
    rotation: 0
    state: enabled
- name: chan_rate
  id: variable
  parameters: {value: int(samp_rate/decim), comment: Sample rate after the channel
      filter (S/s).}
  states:
    coordinate: [8, 520]
    rotation: 0
    state: enabled
- name: avg_len
  id: variable
  parameters: {value: chan_rate, comment: Averaging length (samples) = 1 second of
      channel samples. Reading needs about 1 s to settle.}
  states:
    coordinate: [8, 590]
    rotation: 0
    state: enabled
- name: fc_rx
  id: variable_qtgui_range
  parameters: {label: 'Measurement filter centre (Hz): set to the tone peak', value: '100000',
    start: '20000', stop: '180000', step: '50', widget: counter_slider, rangeType: float,
    gui_hint: '4,0,1,3'}
  states:
    coordinate: [8, 660]
    rotation: 0
    state: enabled
- name: how_to
  id: note
  parameters: {note: 1) Start RX with TX stopped (baseline). 2) Start TX. 3) Set the
      slider to the tone peak in the spectrum. Keep rx_gain fixed.}
  states:
    coordinate: [200, 60]
    rotation: 0
    state: enabled
- name: pluto_rx
  id: iio_pluto_source
  parameters: {type: fc32, uri: pluto_uri, frequency: int(lo_freq), samplerate: int(samp_rate),
    buffer_size: '32768', quadrature: 'True', rfdc: 'True', bbdc: 'True', gain1: '''manual''',
    manual_gain1: rx_gain, filter_source: '''Auto''', comment: 'PlutoSDR Source: manual
      gain = rx_gain (AGC off). Output: complex I/Q at samp_rate.'}
  states:
    coordinate: [200, 200]
    rotation: 0
    state: enabled
- name: xlate
  id: freq_xlating_fir_filter_xxx
  parameters: {type: ccc, decim: decim, taps: 'firdes.low_pass(1, samp_rate, 5e3,
      2e3)', center_freq: fc_rx, samp_rate: samp_rate, comment: 'SELECT CHANNEL: moves
      fc_rx to 0 Hz, keeps +-5 kHz, 960k -> 48k. Unity gain in the passband.'}
  states:
    coordinate: [500, 200]
    rotation: 0
    state: enabled
- name: mag2
  id: blocks_complex_to_mag_squared
  parameters: {vlen: '1', comment: 'INSTANT POWER: I^2 + Q^2 for every sample (linear).'}
  states:
    coordinate: [790, 200]
    rotation: 0
    state: enabled
- name: avg
  id: blocks_moving_average_xx
  parameters: {type: float, length: avg_len, scale: 1.0/avg_len, max_iter: '4000',
    vlen: '1', comment: LINEAR AVERAGE over 1 s = mean(I^2+Q^2). Averaging is done
      BEFORE converting to dB.}
  states:
    coordinate: [1030, 200]
    rotation: 0
    state: enabled
- name: todb
  id: blocks_nlog10_ff
  parameters: {n: '10', k: '0', vlen: '1', comment: 'dB conversion: 10*log10(P). Reference
      0 dB = |z|^2 of 1.0 in the PlutoSDR Source stream.'}
  states:
    coordinate: [1270, 200]
    rotation: 0
    state: enabled
- name: num
  id: qtgui_number_sink
  parameters: {name: '"Relative digital power of selected channel"', type: float,
    autoscale: 'False', avg: '0', graph_type: qtgui.NUM_GRAPH_HORIZ, nconnections: '1',
    min: '-120', max: '0', update_time: '0.25', gui_hint: '5,0,1,3', label1: '"Power
      (dB, relative digital)"', unit1: '"dB"', color1: '("black", "black")', factor1: '1',
    comment: 'THE NUMBER: averaged selected-channel digital power, relative dB. Not
      dBm.'}
  states:
    coordinate: [1510, 200]
    rotation: 0
    state: enabled
- name: spec
  id: qtgui_freq_sink_x
  parameters: {type: complex, bw: samp_rate, fc: '0', fftsize: '8192', name: '"RX
      spectrum (baseband Hz): find the tone peak"', nconnections: '1', gui_hint: '0,0,4,3',
    wintype: window.WIN_BLACKMAN_hARRIS, average: '0.2', ymin: '-120', ymax: '0',
    grid: 'True', axislabels: 'True', ctrlpanel: 'True', update_time: '0.10', label1: '"RX"',
    comment: 'Spectrum: the tone appears near +100 kHz (not exact). Use Control Panel:
      Peak Hold and Marker to read its frequency.'}
  states:
    coordinate: [500, 420]
    rotation: 0
    state: enabled
connections:
- [pluto_rx, '0', xlate, '0']
- [xlate, '0', mag2, '0']
- [mag2, '0', avg, '0']
- [avg, '0', todb, '0']
- [todb, '0', num, '0']
- [pluto_rx, '0', spec, '0']
metadata: {file_format: 1, grc_version: 3.10.9.2}
