options:
  parameters:
    title: Example 1 - Signal basics
    author: Aya - SDR learning course
    copyright: ''
    description: ''
    output_language: python
    generate_options: qt_gui
    gen_linking: dynamic
    gen_cmake: 'On'
    cmake_opt: ''
    category: '[GRC Hier Blocks]'
    run_options: prompt
    placement: (0,0)
    window_size: (1100,800)
    sizing_mode: fixed
    run: 'True'
    max_nouts: '0'
    realtime_scheduling: ''
    qt_qss_theme: ''
    thread_safe_setters: ''
    catch_exceptions: 'True'
    run_command: '{python} -u {filename}'
    hier_block_src_path: '.:'
    id: ex01_signal_basics
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 240
    - 16
    rotation: 0
    state: enabled
- name: tone_freq
  id: variable
  parameters:
    value: '1500'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 470
    - 16
    rotation: 0
    state: enabled
- name: amplitude
  id: variable
  parameters:
    value: '0.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 700
    - 16
    rotation: 0
    state: enabled
- name: reference_tone
  id: analog_sig_source_x
  parameters:
    type: float
    samp_rate: samp_rate
    waveform: analog.GR_COS_WAVE
    freq: tone_freq
    amp: amplitude
    offset: '0'
    phase: '0'
    showports: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 80
    - 300
    rotation: 0
    state: enabled
- name: simulation_clock
  id: blocks_throttle2
  parameters:
    type: float
    samples_per_second: samp_rate
    vlen: '1'
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 360
    - 300
    rotation: 0
    state: enabled
- name: time_view
  id: qtgui_time_sink_x
  parameters:
    type: float
    name: Time - 1500 Hz reference
    ylabel: Digital amplitude
    yunit: ''
    size: '192'
    srate: samp_rate
    grid: 'True'
    autoscale: 'False'
    ymin: '-0.6'
    ymax: '0.6'
    nconnections: '1'
    update_time: '0.1'
    entags: 'False'
    gui_hint: 0,0,1,1
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_MODE_POS
    tr_level: '0.0'
    tr_delay: '0'
    tr_chan: '0'
    tr_tag: '""'
    ctrlpanel: 'False'
    legend: 'True'
    axislabels: 'True'
    stemplot: 'False'
    label1: Signal
    width1: '2'
    color1: red
    style1: '1'
    marker1: '-1'
    alpha1: '1.0'
    label2: Envelope
    width2: '2'
    color2: blue
    style2: '1'
    marker2: '-1'
    alpha2: '1.0'
    label3: Lower envelope
    width3: '2'
    color3: blue
    style3: '1'
    marker3: '-1'
    alpha3: '1.0'
    label4: Signal 4
    width4: '1'
    color4: black
    style4: '1'
    marker4: '-1'
    alpha4: '1.0'
    label5: Signal 5
    width5: '1'
    color5: cyan
    style5: '1'
    marker5: '-1'
    alpha5: '1.0'
    label6: Signal 6
    width6: '1'
    color6: magenta
    style6: '1'
    marker6: '-1'
    alpha6: '1.0'
    label7: Signal 7
    width7: '1'
    color7: yellow
    style7: '1'
    marker7: '-1'
    alpha7: '1.0'
    label8: Signal 8
    width8: '1'
    color8: dark red
    style8: '1'
    marker8: '-1'
    alpha8: '1.0'
    label9: Signal 9
    width9: '1'
    color9: dark green
    style9: '1'
    marker9: '-1'
    alpha9: '1.0'
    label10: Signal 10
    width10: '1'
    color10: dark blue
    style10: '1'
    marker10: '-1'
    alpha10: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 680
    - 250
    rotation: 0
    state: enabled
- name: spectrum_view
  id: qtgui_freq_sink_x
  parameters:
    type: float
    name: Baseband spectrum - real cosine
    fftsize: '4096'
    freqhalf: 'False'
    wintype: window.WIN_RECTANGULAR
    norm_window: 'False'
    fc: '0'
    bw: samp_rate
    grid: 'True'
    autoscale: 'False'
    average: 'False'
    ymin: '-120'
    ymax: '10'
    label: Digital spectral level
    units: dB
    nconnections: '1'
    update_time: '0.15'
    showports: 'False'
    gui_hint: 1,0,1,1
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_level: '0.0'
    tr_chan: '0'
    tr_tag: '""'
    ctrlpanel: 'False'
    legend: 'True'
    axislabels: 'True'
    label1: Input
    width1: '1'
    color1: red
    alpha1: '1.0'
    label2: Filtered
    width2: '1'
    color2: blue
    alpha2: '1.0'
    label3: ''''''
    width3: '1'
    color3: '"green"'
    alpha3: '1.0'
    label4: ''''''
    width4: '1'
    color4: '"black"'
    alpha4: '1.0'
    label5: ''''''
    width5: '1'
    color5: '"cyan"'
    alpha5: '1.0'
    label6: ''''''
    width6: '1'
    color6: '"magenta"'
    alpha6: '1.0'
    label7: ''''''
    width7: '1'
    color7: '"yellow"'
    alpha7: '1.0'
    label8: ''''''
    width8: '1'
    color8: '"dark red"'
    alpha8: '1.0'
    label9: ''''''
    width9: '1'
    color9: '"dark green"'
    alpha9: '1.0'
    label10: ''''''
    width10: '1'
    color10: '"dark blue"'
    alpha10: '1.0'
    averaging: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 680
    - 500
    rotation: 0
    state: enabled
connections:
- - reference_tone
  - '0'
  - simulation_clock
  - '0'
- - simulation_clock
  - '0'
  - time_view
  - '0'
- - simulation_clock
  - '0'
  - spectrum_view
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.12.0
